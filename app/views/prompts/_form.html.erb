<%= form_with model: prompt, class: "space-y-6" do |f| %>
  <% if prompt.errors.any? %>
    <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-xs space-y-1">
      <div class="font-semibold">Please fix the following errors:</div>
      <ul class="list-disc pl-5">
        <% prompt.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <!-- Title -->
    <div>
      <%= f.label :title, "Prompt Title", class: "block text-xs font-mono uppercase text-neutral-300 mb-1.5" %>
      <%= f.text_field :title,
                       placeholder: "e.g., Rails Hotwire Turbo Refactor Prompt",
                       required: true,
                       autofocus: true,
                       class: "w-full px-3.5 py-2 bg-neutral-900 border border-neutral-800 rounded-lg text-sm text-neutral-100 focus:outline-none focus:border-cyan-500 font-medium placeholder-neutral-600" %>
    </div>

    <!-- Project Selection -->
    <div>
      <%= f.label :project_id, "Project (Optional)", class: "block text-xs font-mono uppercase text-neutral-300 mb-1.5" %>
      <%= f.collection_select :project_id,
                              Project.order(:name),
                              :id,
                              :name,
                              { include_blank: "(None / Standalone Prompt)" },
                              { class: "w-full px-3.5 py-2 bg-neutral-900 border border-neutral-800 rounded-lg text-xs font-mono text-neutral-200 focus:outline-none focus:border-cyan-500" } %>
      <p class="text-[11px] text-neutral-500 font-mono mt-1">
        Leave blank to keep this prompt in the standalone "Prompts" list.
      </p>
    </div>

    <!-- Markdown Body -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <%= f.label :body, "Markdown Content", class: "block text-xs font-mono uppercase text-neutral-300" %>
        <span class="text-[11px] font-mono text-neutral-500">Supports GFM, code blocks & tables</span>
      </div>
      <%= f.text_area :body,
                      rows: 14,
                      placeholder: "# Instructions\nYou are a developer assistant...\n\n```ruby\ndef hello\n  puts 'world'\nend\n```",
                      class: "w-full p-4 bg-neutral-900 border border-neutral-800 rounded-xl text-neutral-200 font-mono text-sm leading-relaxed focus:outline-none focus:border-cyan-500/80 focus:ring-1 focus:ring-cyan-500/50 resize-y shadow-inner placeholder-neutral-600" %>
    </div>

    <!-- Initial File Attachments Dropzone -->
    <div class="space-y-2" data-controller="dropzone">
      <label class="block text-xs font-mono uppercase text-neutral-300">
        Attach Files (Dropzone)
      </label>

      <%= f.file_field :files,
                       multiple: true,
                       data: { dropzone_target: "input", action: "change->dropzone#fileChosen" },
                       class: "sr-only",
                       id: "new_prompt_files_input" %>

      <label for="new_prompt_files_input"
             data-dropzone-target="area"
             data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
             class="flex flex-col items-center justify-center p-6 border-2 border-dashed border-neutral-800 hover:border-cyan-500/50 rounded-xl bg-neutral-900/40 hover:bg-neutral-900/80 transition cursor-pointer">
        <div class="w-8 h-8 rounded-full bg-neutral-800 flex items-center justify-center text-neutral-400 mb-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <p class="text-xs text-neutral-300">
          <span class="text-cyan-400 font-semibold underline underline-offset-2">Browse files</span> or drop them here
        </p>
        <p class="text-[11px] text-neutral-500 font-mono mt-0.5">
          Files will be attached when the prompt is saved
        </p>
      </label>

      <!-- Staged Files Preview -->
      <div data-dropzone-target="preview" class="hidden space-y-1 pt-1"></div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center gap-3 pt-4 border-t border-neutral-800">
    <%= f.submit prompt.persisted? ? "Save Changes" : "Create Prompt",
                 class: "px-5 py-2 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-lg transition shadow-sm cursor-pointer" %>

    <%= link_to "Cancel", prompt.persisted? ? prompt_path(prompt) : root_path,
                class: "px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium text-xs rounded-lg transition" %>
  </div>
<% end %>
