<div id="prompt_attachments" class="space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <h3 class="text-sm font-semibold text-neutral-200 uppercase tracking-wider font-mono">
        Attachments
      </h3>
      <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-neutral-800 text-neutral-400 border border-neutral-700/60">
        <%= prompt.files.count %>
      </span>
    </div>
    <div class="text-xs text-neutral-500 font-mono">
      Dropzone ActiveStorage
    </div>
  </div>

  <!-- Interactive Drag & Drop Area -->
  <div data-controller="dropzone"
       data-dropzone-upload-url-value="<%= attach_files_prompt_path(prompt) %>"
       class="relative">
    <input type="file"
           multiple
           data-dropzone-target="input"
           data-action="change->dropzone#fileChosen"
           class="sr-only"
           id="prompt_file_upload_<%= prompt.id %>">

    <label for="prompt_file_upload_<%= prompt.id %>"
           data-dropzone-target="area"
           data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
           class="flex flex-col items-center justify-center p-6 border-2 border-dashed border-neutral-800 hover:border-cyan-500/50 rounded-xl bg-neutral-900/40 hover:bg-neutral-900/80 transition-all cursor-pointer group">
      <div class="w-10 h-10 rounded-full bg-neutral-800 group-hover:bg-cyan-500/10 flex items-center justify-center text-neutral-400 group-hover:text-cyan-400 mb-2 transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>
      <p class="text-xs font-medium text-neutral-300 group-hover:text-cyan-300">
        <span class="text-cyan-400 font-semibold underline underline-offset-2">Click to browse</span> or drag & drop files here
      </p>
      <p class="text-[11px] text-neutral-500 font-mono mt-1">
        Supports images, code, markdown, logs, and documents
      </p>

      <div data-dropzone-target="status"></div>
    </label>
  </div>

  <!-- Attached Files List -->
  <% if prompt.files.attached? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-2">
      <% prompt.files.each do |file| %>
        <div class="group relative flex items-start gap-3 p-3 bg-neutral-900/70 border border-neutral-800 rounded-lg hover:border-neutral-700 transition">
          <!-- Thumbnail / Icon -->
          <div class="w-10 h-10 shrink-0 rounded bg-neutral-800 flex items-center justify-center overflow-hidden border border-neutral-700/50">
            <% if file.image? %>
              <%= image_tag file.representation(resize_to_limit: [100, 100]), class: "w-full h-full object-cover" rescue image_tag(file, class: "w-full h-full object-cover") %>
            <% else %>
              <svg class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            <% end %>
          </div>

          <!-- File Meta -->
          <div class="flex-1 min-w-0 pr-6">
            <p class="text-xs font-mono font-medium text-neutral-200 truncate" title="<%= file.filename %>">
              <%= file.filename %>
            </p>
            <p class="text-[11px] font-mono text-neutral-500 mt-0.5">
              <%= number_to_human_size(file.byte_size) %>
            </p>

            <div class="flex items-center gap-2 mt-2">
              <%= link_to rails_blob_path(file, disposition: "attachment"), class: "inline-flex items-center gap-1 text-[11px] font-mono text-cyan-400 hover:text-cyan-300 hover:underline" do %>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download
              <% end %>
              <span class="text-neutral-700">•</span>
              <%= link_to rails_blob_path(file, disposition: "inline"), target: "_blank", rel: "noopener", class: "text-[11px] font-mono text-neutral-400 hover:text-neutral-200 hover:underline" do %>
                View
              <% end %>
            </div>
          </div>

          <!-- Delete Button -->
          <div class="absolute top-2.5 right-2.5">
            <%= button_to attachment_prompt_path(prompt, file.id),
                          method: :delete,
                          form: { data: { turbo_confirm: "Are you sure you want to remove #{file.filename}?" } },
                          class: "p-1 rounded text-neutral-500 hover:text-rose-400 hover:bg-neutral-800 transition",
                          title: "Delete attachment" do %>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
