<% content_for :title, "Edit #{@prompt.title} — Devbook" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-white">Edit Prompt</h1>
      <p class="text-xs text-neutral-400 mt-1 font-mono">
        Update prompt details, project assignment, or markdown body
      </p>
    </div>
  </div>

  <%= render "form", prompt: @prompt %>
</div>
