<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-xs space-y-1">
      <div class="font-semibold">Please fix the following errors:</div>
      <ul class="list-disc pl-5">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Project Name", class: "block text-xs font-mono uppercase text-neutral-300 mb-1.5" %>
    <%= f.text_field :name,
                     placeholder: "e.g., Project A, Code Review Bot, API v2",
                     required: true,
                     autofocus: true,
                     class: "w-full px-3.5 py-2 bg-neutral-900 border border-neutral-800 rounded-lg text-sm text-neutral-100 focus:outline-none focus:border-cyan-500 font-medium placeholder-neutral-600" %>
  </div>

  <div>
    <%= f.label :description, "Description (Optional)", class: "block text-xs font-mono uppercase text-neutral-300 mb-1.5" %>
    <%= f.text_area :description,
                    rows: 3,
                    placeholder: "Brief summary of what prompts belong here...",
                    class: "w-full p-3.5 bg-neutral-900 border border-neutral-800 rounded-lg text-xs text-neutral-200 focus:outline-none focus:border-cyan-500 placeholder-neutral-600 resize-none" %>
  </div>

  <div class="flex items-center gap-3 pt-3 border-t border-neutral-800">
    <%= f.submit project.persisted? ? "Update Project" : "Create Project",
                 class: "px-5 py-2 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-lg transition shadow-sm cursor-pointer" %>

    <%= link_to "Cancel", project.persisted? ? project_path(project) : projects_path,
                class: "px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium text-xs rounded-lg transition" %>
  </div>
<% end %>
