<% content_for :title, "#{@project.name} — Devbook" %>

<div class="max-w-6xl mx-auto space-y-6">
  <!-- Breadcrumbs & Actions -->
  <div class="flex items-center justify-between text-xs font-mono text-neutral-500">
    <div class="flex items-center gap-1.5">
      <%= link_to "Devbook", root_path, class: "hover:text-neutral-300 transition" %>
      <span>/</span>
      <%= link_to "Projects", projects_path, class: "hover:text-neutral-300 transition" %>
      <span>/</span>
      <span class="text-neutral-300 font-semibold"><%= @project.name %></span>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to edit_project_path(@project), class: "px-2.5 py-1 rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 hover:text-white border border-neutral-700/60 transition text-xs font-mono whitespace-nowrap" do %>
        Edit
      <% end %>

      <%= button_to project_path(@project),
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to delete this project? Its prompts will become standalone." } },
                    class: "px-2.5 py-1 rounded text-rose-400 hover:bg-rose-500/10 border border-rose-500/30 transition text-xs font-mono whitespace-nowrap" do %>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Project Header Banner -->
  <div class="p-6 bg-neutral-900 border border-neutral-800 rounded-2xl">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-950/70 border border-cyan-800/40 flex items-center justify-center text-cyan-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-white"><%= @project.name %></h1>
        </div>

        <% if @project.description.present? %>
          <p class="text-sm text-neutral-400 leading-relaxed max-w-2xl">
            <%= @project.description %>
          </p>
        <% end %>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <%= link_to new_project_prompt_path(@project), class: "inline-flex items-center gap-1.5 px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-xl transition shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New Prompt in Project
        <% end %>
      </div>
    </div>
  </div>

  <!-- Prompts in this Project Section -->
  <div class="space-y-4 pt-2">
    <div class="flex items-center justify-between pb-2 border-b border-neutral-800">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-semibold text-neutral-200">
          Prompts in this Project
        </h2>
        <span class="px-2 py-0.5 rounded-full text-xs font-mono bg-neutral-800 text-neutral-400 border border-neutral-700/60">
          <%= @prompts.size %>
        </span>
      </div>

      <!-- Quick Search within project -->
      <div class="w-64">
        <%= form_with url: project_path(@project), method: :get, class: "relative" do |f| %>
          <%= f.text_field :q, value: params[:q], placeholder: "Filter prompts...", class: "w-full pl-8 pr-3 py-1 text-xs bg-neutral-900 border border-neutral-800 rounded-md text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-cyan-500" %>
          <svg class="w-3.5 h-3.5 text-neutral-500 absolute left-2.5 top-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        <% end %>
      </div>
    </div>

    <% if @prompts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @prompts.each do |prompt| %>
          <%= render "prompts/prompt_card", prompt: prompt %>
        <% end %>
      </div>
    <% else %>
      <div class="p-10 text-center border-2 border-dashed border-neutral-800/80 rounded-xl bg-neutral-900/20 max-w-md mx-auto my-8">
        <p class="text-xs text-neutral-400 mb-4">
          <%= params[:q].present? ? "No prompts matched your search in this project." : "No prompts in this project yet." %>
        </p>
        <%= link_to new_project_prompt_path(@project), class: "inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-lg transition" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add First Prompt
        <% end %>
      </div>
    <% end %>
  </div>
</div>
