<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-white">Projects</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-neutral-800 text-neutral-400 border border-neutral-700/60">
          <%= @projects.size %>
        </span>
      </div>
      <p class="text-xs text-neutral-400 mt-1 font-mono">
        Group related prompts by application, workflow, or repository
      </p>
    </div>

    <%= link_to new_project_path, class: "inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-lg transition shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New Project
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @projects.each do |project| %>
        <div class="group flex flex-col justify-between p-5 bg-neutral-900 border border-neutral-800 rounded-xl hover:border-neutral-700 hover:shadow-lg transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-8 h-8 rounded-lg bg-cyan-950/70 border border-cyan-800/40 flex items-center justify-center text-cyan-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              </div>
              <span class="text-xs font-mono text-neutral-500">
                <%= pluralize(project.prompts.size, "prompt") %>
              </span>
            </div>

            <%= link_to project_path(project), class: "block font-bold text-neutral-100 group-hover:text-cyan-400 transition text-base tracking-tight mb-1" do %>
              <%= project.name %>
            <% end %>

            <% if project.description.present? %>
              <p class="text-xs text-neutral-400 line-clamp-2 leading-relaxed">
                <%= project.description %>
              </p>
            <% end %>
          </div>

          <div class="mt-4 pt-3 border-t border-neutral-800/70 flex items-center justify-between">
            <%= link_to project_path(project), class: "text-xs font-mono text-cyan-400 hover:underline flex items-center gap-1" do %>
              Open project
              <span class="text-[10px]">→</span>
            <% end %>

            <%= link_to new_project_prompt_path(project), class: "text-xs font-mono text-neutral-400 hover:text-white" do %>
              + Add prompt
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-12 text-center border-2 border-dashed border-neutral-800/80 rounded-2xl bg-neutral-900/20 max-w-lg mx-auto my-12">
      <div class="w-12 h-12 rounded-xl bg-neutral-800/80 flex items-center justify-center text-neutral-500 mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-neutral-200 mb-1">No projects created yet</h3>
      <p class="text-xs text-neutral-400 mb-5">
        Organize your prompts by creating projects like "Backend Services", "Prompt Engineering", or "UI Components".
      </p>
      <%= link_to new_project_path, class: "inline-flex items-center gap-1.5 px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-semibold text-xs rounded-lg transition" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create Project
      <% end %>
    </div>
  <% end %>
</div>
